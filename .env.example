# ---------------------------------------------------------------------------
# Veritas environment configuration template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Neo4j connection ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please_change_me
NEO4J_DATABASE=neo4j

# --- LLM provider ---
# Provider used for entity/relationship extraction. Options: "openai" | "spacy"
VERITAS_EXTRACTION_BACKEND=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
# Options: "openai" | "sentence_transformers"
VERITAS_EMBEDDING_BACKEND=sentence_transformers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# Vector dimension MUST match the embedding model output.
#   text-embedding-3-small -> 1536
#   all-MiniLM-L6-v2       -> 384
VERITAS_EMBEDDING_DIMENSION=384

# --- Chunking ---
VERITAS_CHUNK_SIZE=800
VERITAS_CHUNK_OVERLAP=120
